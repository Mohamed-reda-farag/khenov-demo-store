{
  "name": "khenov-demo-store",
  "version": "0.1.0",
  "private": true,
  "description": "ATHAR — fictional footwear store. A KHENOV portfolio demo (static, no backend).",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "preview": "serve out -l 4173",

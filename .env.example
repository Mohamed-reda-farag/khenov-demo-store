# Build-time settings. Every variable is optional; the defaults suit local work.
# Copy to .env.local for local use, or set them in the host's dashboard (Cloudflare Pages: Settings >
# Variables and Secrets). NEXT_PUBLIC_* values are baked into the build, so rebuild after changing them.

# The public address of the deployed site, no trailing slash. Used for canonical / hreflang / share
# image URLs. Set it to your real URL in production; the default points at localhost.
NEXT_PUBLIC_SITE_URL=https://your-project.pages.dev

# Sub-path the site is served from, e.g. /khenov-demo-store on a GitHub Pages project site.
# Leave EMPTY (or unset) on a root domain such as *.pages.dev.
NEXT_PUBLIC_BASE_PATH=

# The demo is noindex by default. Set to true ONLY if you want search engines to index it.
NEXT_PUBLIC_ALLOW_INDEXING=

# The repository's public address (no trailing slash). When set, the Privacy page links the
# photo credits file in it.
NEXT_PUBLIC_REPO_URL=
